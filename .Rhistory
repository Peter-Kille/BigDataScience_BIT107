# Keep only numeric columns
num_data <- data_clean_t[, sapply(data_clean_t, is.numeric)]
# Compute correlation with Candida_cell
cor_with_candida <- cor(num_data$Candida_cell, num_data, use = "pairwise.complete.obs")
# Drop self-correlation
cor_with_candida <- cor_with_candida[, colnames(num_data) != "Candida_cell"]
# Filter variables with |correlation| >= 0.7
high_corr_vars <- names(cor_with_candida)[abs(cor_with_candida) >= 0.7]
# Subset the data to include only Candida_cell + high-correlation variables
subset_data <- num_data[, c("Candida_cell", high_corr_vars)]
# Plot correlation chart
chart.Correlation(subset_data, histogram = TRUE, pch = 19)
